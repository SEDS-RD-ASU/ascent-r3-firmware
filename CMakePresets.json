{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "main",
      "cacheVariables": {
        "IDF_TARGET": "esp32s3"
      },
      "vendor": {
        "espressif/vscode-esp-idf": {
          "schemaVersion": 1,
          "settings": [
            {
              "type": "flashBaudRate",
              "value": "115200"
            },
            {
              "type": "monitorBaudRate",
              "value": "115200"
            }
          ]
        }
      }
    }
  ]
}
